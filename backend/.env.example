# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=5000
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/phishguard
DATABASE_SSL=false
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"  (min 32 chars)
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Failed logins per IP per window (successful logins are not counted)
AUTH_RATE_LIMIT_MAX=10
# Registrations per IP per hour
REGISTER_RATE_LIMIT_MAX=10
MAX_UPLOAD_MB=25
LOG_LEVEL=info
# Future ML service (not used yet; analysis is mocked)
ML_SERVICE_URL=
# Used only by `npm run db:seed` (development). Passwords must be 12+ chars and are stored as bcrypt hashes.
SEED_DEMO_PASSWORD=
# Separate, disposable database for `npm test` (its name MUST contain "test"; it is wiped on every run)
TEST_DATABASE_URL=
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- analysis engine (Python service, POST /analyze) ---
# Empty = use the built-in MOCK analyzer (allowed in development only)
ANALYSIS_SERVICE_URL=http://127.0.0.1:8000
# Must equal ML_API_KEY of the Python service
ANALYSIS_API_KEY=
ANALYSIS_TIMEOUT_MS=45000
ANALYSIS_CONCURRENCY=4
# A scan stuck in "Running" longer than this is marked Failed
ANALYSIS_STALE_SECONDS=180
# ANALYSIS_ALLOW_MOCK=true
