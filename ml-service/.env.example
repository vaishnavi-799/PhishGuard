# Directory containing the trained model artifacts (model.json / metadata.json)
MODEL_DIR=models
# Shared secret the Node backend sends in the X-API-Key header. REQUIRED outside local development.
ML_API_KEY=
LOG_LEVEL=info

# --- analysis engine (POST /analyze) ---
ANALYSIS_ENABLE_NETWORK=true        # false = offline analysis only (no DNS/RDAP/TLS/page fetch)
ANALYSIS_ALLOW_PRIVATE=false        # keep false: blocks requests to private/loopback/metadata addresses (SSRF guard)
ANALYSIS_TOTAL_TIMEOUT=20
ANALYSIS_MAX_CONCURRENT=8
DNS_RESOLVERS=                      # comma separated; empty = system resolvers
RDAP_ENABLED=true
DNSBL_ZONES=                        # optional, e.g. dbl.spamhaus.org (check the provider's usage policy)
BLOCKLIST_PATH=                     # optional text file, one domain per line
RISK_ML_WEIGHT=0.4
